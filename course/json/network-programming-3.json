  "definitions": [
    {
      "term": "Concurrent server",
      "definition": "A server that handles multiple clients simultaneously"
    },
    {
      "term": "Pre-forked server",
      "definition": "Server that creates a pool of child processes before clients connect"
    },
    {
      "term": "Pre-threaded server",
      "definition": "Server that creates a pool of threads before clients connect"
    },
    {
      "term": "recvmsg()",
      "definition": "Advanced receive primitive supporting scatter/gather and ancillary data"
    },
    {
      "term": "sendmsg()",
      "definition": "Advanced send primitive supporting scatter/gather and ancillary data"
    }
  ],
